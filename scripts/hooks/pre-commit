#!/usr/bin/env bash
# OPSEC_SOVEREIGN_SHIELD — pre-commit gate (invariants 1/3/5).
# Fails the commit if a STAGED ADDED line contains:
#   - host-absolute paths or private-network addresses
#     (loopback 127.0.0.1 and the documented 10.0.0.x simulation range pass);
#   - Cyrillic text (standing repo rule; box-drawing comment separators are
#     established style and are not flagged);
#   - style violations under .clang-format in the touched line ranges.
# Commit timestamps are enforced at pre-push (see scripts/hooks/pre-push);
# create commits through scripts/commit_utc.sh so they are +0000 at birth.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

status=0

# ── 1. Leak scan over staged added lines ────────────────────────────────────
# Pattern fragments are assembled so the hook never matches its own source.
p_home='/home'; p_users='/Users'
p_192='192\.168\.[0-9]+\.[0-9]+'
p_172='172\.(1[6-9]|2[0-9]|3[0-1])\.[0-9]+\.[0-9]+'
leak_re="(${p_home}/|${p_users}/|${p_192}|${p_172})"
allow_re='10\.0\.0\.[0-9]+|127\.0\.0\.1'
added=$(git diff --cached --unified=0 -- . | grep '^+' | grep -v '^+++' || true)
if [ -n "$added" ]; then
    if grep -nE "$leak_re" <<<"$added" | grep -vE "$allow_re"; then
        echo "OPSEC pre-commit: host path / private IP in staged lines (see above). Commit BLOCKED."
        status=1
    fi
    if grep -nP '[\x{0400}-\x{04FF}]' <<<"$added"; then
        echo "OPSEC pre-commit: Cyrillic in staged lines (see above). Commit BLOCKED."
        status=1
    fi
fi

# ── 2. clang-format on staged line ranges (anti-stylometry) ─────────────────
if command -v clang-format >/dev/null 2>&1; then
    while IFS= read -r f; do
        case "$f" in *.cpp|*.cc|*.hpp|*.h) ;; *) continue ;; esac
        ranges=$(git diff --cached -U0 -- "$f" | awk '/^@@/{gsub("[^0-9,+]","",$3); print $3}' | tr -d '+')
        [ -n "$ranges" ] || continue
        for r in $ranges; do
            start=${r%%,*}; end=${start}; [ "$r" = "$start" ] || end=${r##*,}
            if ! clang-format --dry-run -Werror --lines="$start:$end" "$f" >/dev/null 2>&1; then
                echo "OPSEC pre-commit: $f lines $start:$end violate .clang-format."
                echo "  Run: scripts/format_staged.sh   (then re-add the file)"
                status=1
            fi
        done
    done < <(git diff --cached --name-only)
fi

if [ "$status" -eq 0 ]; then
    echo "OPSEC pre-commit: staged diff clean."
fi
exit "$status"
