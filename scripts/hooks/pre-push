#!/usr/bin/env bash
# OPSEC_SOVEREIGN_SHIELD — pre-push gate (invariant 1).
# Blocks the push if ANY commit in the outgoing range carries an author or
# committer timestamp offset other than +0000. Every pushed byte must be
# timezone-sterile; host-local time must never reach the public history.
set -uo pipefail
zero=0000000000000000000000000000000000000000
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # deletion, nothing to check
    if [ "$remote_sha" = "$zero" ]; then
        # new ref: check the pushed tip commit itself
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    while IFS='|' read -r sha aoff coff; do
        if [ "$aoff" != "+0000" ] || [ "$coff" != "+0000" ]; then
            echo "OPSEC pre-push: BLOCKED - commit $sha has non-UTC offsets (author=$aoff committer=$coff)."
            echo "  Re-commit via: scripts/commit_utc.sh (TZ=UTC, epoch dates)"
            fail=1
        fi
    done < <(git log --format='%H|%ai|%ci' "$range" | awk -F'|' '{split($2,a," ");split($3,c," ");print $1"|"a[2]"|"c[2]}')
done

if [ "$fail" -eq 0 ]; then
    echo "OPSEC pre-push: all outgoing commits are +0000."
fi
exit "$fail"
